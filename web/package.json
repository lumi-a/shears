{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm:build": "wasm-pack build ../crates/wasm --target web --out-dir ../../web/src/wasm-pkg --out-name shears_wasm",
    "predev": "pnpm run wasm:build",
    "dev": "vite",
    "prebuild": "pnpm run wasm:build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-solid": "^0.18.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
